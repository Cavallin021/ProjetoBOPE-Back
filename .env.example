# Application
PORT=3001
NODE_ENV=development

# Database (Neon / PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Armazenamento de propostas e contratos: "local" (disco) ou "drive" (Google Drive compartilhado)
STORAGE_DRIVER=local

# local: diretório onde os arquivos são salvos
UPLOAD_DIR=uploads

# drive: id da pasta dentro do Drive compartilhado (parte final da URL da pasta)
GOOGLE_DRIVE_FOLDER_ID=
# drive: conta de serviço do Google Cloud, adicionada ao Drive compartilhado como "Administrador de conteúdo"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# drive: campo private_key do JSON da conta de serviço, numa linha só, entre aspas
GOOGLE_PRIVATE_KEY=
