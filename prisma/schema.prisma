generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  GESTOR
  MEMBRO
}

enum ClientStatus {
  ATIVO
  INATIVO
}

enum DealStage {
  DIAGNOSTICA
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum DocumentType {
  PROPOSTA
  CONTRATO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  username  String
  role      Role     @default(MEMBRO)
  createdAt DateTime @default(now())

  dealsAsBope1    Deal[]     @relation("Bope1Deals")
  dealsAsBope2    Deal[]     @relation("Bope2Deals")
  dealsAsGuardiao Deal[]     @relation("GuardiaoDeals")
  auditLogs       AuditLog[]

  @@map("users")
}

model Client {
  id         String       @id @default(uuid())
  name       String
  profession String
  income     Float
  location   String
  status     ClientStatus @default(ATIVO)
  createdAt  DateTime     @default(now())

  deals      Deal[]
  documents  ClientDocument[]
  auditLogs  AuditLog[]

  @@map("clients")
}

model ClientDocument {
  id        String       @id @default(uuid())
  clientId  String
  type      DocumentType
  fileUrl   String
  fileName  String?
  createdAt DateTime     @default(now())

  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_documents")
}

model Deal {
  id               String    @id @default(uuid())
  clientId         String
  
  bope1Id          String
  bope2Id          String?
  guardiaoNdpId    String? 

  value            Decimal   @db.Decimal(12, 2)
  leadType         String?
  stage            DealStage @default(DIAGNOSTICA)
  lostReason       String?
  firstContactDate DateTime  @default(now())
  closedDate       DateTime?

  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bope1            User      @relation("Bope1Deals", fields: [bope1Id], references: [id], onDelete: Restrict)
  bope2            User?     @relation("Bope2Deals", fields: [bope2Id], references: [id], onDelete: SetNull)
  guardiaoNdp      User?     @relation("GuardiaoDeals", fields: [guardiaoNdpId], references: [id], onDelete: SetNull)
  auditLogs        AuditLog[]

  @@map("deals")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String
  action         String
  targetClientId String?
  targetDealId   String?  // Necessário para a BACK-12 (auditoria de alterações da Lead)
  timestamp      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetClient   Client?  @relation(fields: [targetClientId], references: [id], onDelete: SetNull)
  targetDeal     Deal?    @relation(fields: [targetDealId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}